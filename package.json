{
  "name": "voxleaf",
  "productName": "VoxLeaf",
  "version": "1.0.0",
  "private": true,
  "description": "VoxLeaf — a self-contained reading and listening library. Desktop edition built with Tauri 2 and Rust.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri",
    "build:core": "cargo test --workspace"
  },
