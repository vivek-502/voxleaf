{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VoxLeaf",
  "version": "1.0.0",
  "identifier": "com.voxleaf.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5177",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "nsis"
    ],
    "category": "Entertainment",
    "shortDescription": "A self-contained reading and listening library.",
    "longDescription": "VoxLeaf turns the EPUBs you own into something you can read or listen to, with a full player, chapter management and narration on demand.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "webkit2gtk-4.1"
        ],
        "section": "sound"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "publisher": "VoxLeaf contributors",
    "copyright": "MIT License \u2014 VoxLeaf contributors"
  }
}
